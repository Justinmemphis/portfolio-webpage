---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} | Justin Carter`}
  description={post.data.excerpt}
  ogImage={post.data.coverImage}
>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        {post.data.tags.length > 0 && (
          <ul class="tag-list">
            {post.data.tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>
        )}
      </div>
      {post.data.excerpt && <p class="excerpt">{post.data.excerpt}</p>}
    </header>

    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 800px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    line-height: 1.3;
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  time {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .tag-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--bg-secondary);
    color: var(--accent-secondary);
    border: 1px solid var(--accent-secondary);
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .excerpt {
    color: var(--text-secondary);
    font-style: italic;
    margin: 0;
  }

  /* Markdown body styles */
  .post-body {
    color: var(--text-primary);
    line-height: 1.8;
  }

  .post-body :global(h2) {
    font-size: 1.5rem;
    color: var(--accent-secondary);
    margin: 2rem 0 1rem;
  }

  .post-body :global(h3) {
    font-size: 1.2rem;
    color: var(--text-primary);
    margin: 1.5rem 0 0.75rem;
  }

  .post-body :global(p) { margin: 0 0 1.25rem; }

  .post-body :global(a) {
    color: var(--accent-secondary);
    text-decoration: underline;
  }

  .post-body :global(code) {
    background: var(--bg-secondary);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .post-body :global(pre) {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-body :global(img) {
    max-width: 100%;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    margin: 1rem 0;
  }

  .post-body :global(ul), .post-body :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
  }

  .post-body :global(li) { margin-bottom: 0.4rem; }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent-secondary);
    margin: 0 0 1.25rem;
    padding: 0.5rem 0 0.5rem 1rem;
    color: var(--text-secondary);
  }
</style>
