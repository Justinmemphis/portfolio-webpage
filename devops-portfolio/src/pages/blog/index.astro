---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSearch from '../../components/BlogSearch';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog | Justin Carter" description="DevOps notes, infrastructure write-ups, and technical progress from Justin Carter.">
  <div class="blog-page">
    <header class="blog-header">
      <h1>Blog</h1>
      <p class="blog-subtitle">DevOps notes, infrastructure write-ups, and technical progress.</p>
    </header>

    <BlogSearch posts={posts.map(p => ({
      slug: p.id,
      title: p.data.title,
      date: p.data.date.toISOString(),
      formattedDate: p.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      }),
      excerpt: p.data.excerpt,
      tags: p.data.tags,
    }))} client:load />
  </div>
</BaseLayout>

<style>
  .blog-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
  }

  .blog-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-subtitle {
    color: var(--text-secondary);
    margin: 0;
    max-width: none;
  }
</style>
