---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import Projects from '../components/Projects';
import Skills from '../components/Skills';
import Contact from '../components/Contact';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Justin Carter",
  "jobTitle": "Business Solutions Developer II",
  "worksFor": {
    "@type": "Organization",
    "name": "CAMP Systems International"
  },
  "url": "https://justinmemphis.com",
  "description": "Business Solutions Developer based in Memphis, TN working in systems integration, Power BI, and HubSpot, with hands-on AWS, Terraform, and CI/CD projects.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Memphis",
    "addressRegion": "TN",
    "addressCountry": "US"
  },
  "sameAs": [
    "https://www.linkedin.com/in/justin-carter-memphis/",
    "https://github.com/Justinmemphis"
  ]
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section id="home">
    <Hero client:load />
    <Projects client:visible />
    <Skills client:visible />
    <Contact client:visible />
  </section>
</BaseLayout>
